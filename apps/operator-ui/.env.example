# Optional. When unset the UI uses the Vite dev proxy at /api/v1.
# VITE_API_BASE_URL=http://localhost:8080/api/v1

# Optional MapLibre style URL. When unset a minimal dark OSM raster style is used.
# VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Required for authenticated local builds. Staging/production injects the
# token at container startup through /config.js; it is never baked into the
# immutable UI image. The browser never invents a token or identity.
# VITE_API_TOKEN=dev-operator-token
