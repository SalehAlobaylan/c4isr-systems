# C4ISR server configuration (copy to .env)

C4ISR_HTTP_ADDR=:8080
C4ISR_DATABASE_URL=postgres://c4isr:c4isr@localhost:5433/c4isr?sslmode=disable
C4ISR_LOG_LEVEL=info
C4ISR_LOG_FORMAT=text
C4ISR_SCENARIOS_DIR=./scenarios
C4ISR_ALLOWED_ORIGINS=http://localhost:5173
C4ISR_ENV=development
C4ISR_AUTH_REQUIRED=true
# Comma-separated operator-id=token pairs. Replace the local default before deployment.
C4ISR_AUTH_TOKENS=operator-01=dev-operator-token

# Production/staging deployments should mount these instead of setting inline
# values: C4ISR_DATABASE_URL_FILE and C4ISR_AUTH_TOKENS_FILE.
# C4ISR_VERSION=dev
