# C4ISR server configuration (copy to .env)

C4ISR_HTTP_ADDR=:8080
# Task dev:api/dev:web share this optional API port override; the UI stays on 5173.
# C4ISR_DEV_PORT=8081
# With a custom API address, set the matching Task dev:web proxy origin:
# C4ISR_API_PROXY_TARGET=http://localhost:8081
# Direct pnpm dev launches use VITE_API_PROXY_TARGET instead.
C4ISR_DATABASE_URL=postgres://c4isr:c4isr@localhost:5433/c4isr?sslmode=disable
C4ISR_LOG_LEVEL=info
C4ISR_LOG_FORMAT=text
C4ISR_SCENARIOS_DIR=./scenarios
C4ISR_TELEMETRY_STALE_AFTER=5m
# Freshness bands. The server classifies every entity on read and the interface
# renders that verdict, so these thresholds decide what the operator is told to
# trust. C4ISR_TELEMETRY_STALE_AFTER is the middle band; the others bracket it.
# Misordered values are repaired rather than rejected.
C4ISR_FRESHNESS_DELAYED_AFTER=1m
C4ISR_FRESHNESS_UNAVAILABLE_AFTER=30m
C4ISR_ALLOWED_ORIGINS=http://localhost:5173
C4ISR_ENV=development
C4ISR_AUTH_REQUIRED=true
# Comma-separated operator-id=token pairs. Replace the local default before deployment.
C4ISR_AUTH_TOKENS=operator-01=dev-operator-token

# Public connectors are off by default. This optional server-owned JSON file
# binds reviewed provider locations to canonical PUBLIC_EVIDENCE sources.
# C4ISR_PUBLIC_CONNECTORS_FILE=./private/public-connectors.json
# Optional FIRMS NOAA-20 connector: server environment only; obtain a NASA map key.
# FIRMS_MAP_KEY=
# See scripts/data/firms-connectors.example.json and docs/implementation/S0_4_P1_5_6_ADAPTER_AND_PUBLIC_HISTORY.md.
# See docs/implementation/P1_1_PUBLIC_INGESTION.md before enabling an admission.

# Production/staging deployments should mount these instead of setting inline
# values: C4ISR_DATABASE_URL_FILE and C4ISR_AUTH_TOKENS_FILE.
# C4ISR_VERSION=dev

# Optional P2 immutable imagery/analysis storage. Provision a private bucket first.
# Configure the API and independent emad-imagery worker identically.
# C4ISR_ARTIFACT_S3_ENDPOINT=https://your-trusted-s3-endpoint
# C4ISR_ARTIFACT_S3_BUCKET=emad-imagery
# C4ISR_ARTIFACT_S3_REGION=us-east-1
# C4ISR_ARTIFACT_S3_ACCESS_KEY_FILE=./private/artifact-access-key
# C4ISR_ARTIFACT_S3_SECRET_KEY_FILE=./private/artifact-secret-key
# See docs/implementation/P2_1_3_IMAGERY_INTELLIGENCE.md for worker/admission setup.

# Optional P3 bounded moving feeds. Nothing polls until an admitted service runs.
# OpenSky operational use requires its written agreement, despite anonymous API access.
# AISStream requires a server-only API key and independently reviewed use/retention rights.
# AISSTREAM_API_KEY=
# See scripts/data/moving-connectors.example.json and the disabled admission templates.
# See docs/implementation/P2_4_P3_1_2_CONTEXT_AND_MOVING.md for limits and worker setup.

# Optional P3.3 station weather and official earthquake bulletin pilots, off by default.
# Merge scripts/data/weather-report-connectors.example.json into the trusted manifest.
# Review the disabled metar/gdacs admission templates, including analyst question,
# station/upstream rights and archive retention. Both use fixed public HTTPS endpoints.
# See docs/implementation/P3_3_WEATHER_AND_REPORTS.md. Apply migration 33 before startup.

# S1.1 simulation asset imports reuse the private C4ISR_ARTIFACT_S3_* store.
# API startup never imports or renders models. Install workspace dependencies,
# provision an EXERCISE_INPUT author/import worker, then run apps/emad-assets.
# Default trusted wrapper: apps/emad-asset-validator/validate.mjs (Node 20+).
# See docs/implementation/S1_1_MODEL_ASSET_REGISTRY.md. Apply migration 34.

# S1.3 / S2.1 requires migration 35 and an explicit Studio author/runtime identity.
# emad-runtime uses only HTTPS API access and its private service token file.
# API startup never launches the runtime. See docs/implementation/S1_3_S2_1_STUDIO_AND_NATIVE_RUNTIME.md.
