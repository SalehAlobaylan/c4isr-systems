# Copy to deployments/staging/.env.staging. Never commit the copied file.
# `task staging:init` creates the file-backed secrets directory.

COMPOSE_PROJECT_NAME=c4isr-staging
STAGING_SECRET_DIR=./.secrets
C4ISR_VERSION=staging

# The UI and API are exposed on localhost only by the staging Compose file.
C4ISR_ALLOWED_ORIGINS=http://localhost:8081
C4ISR_UI_API_BASE_URL=/api/v1
VITE_MAP_STYLE_URL=

# Set this to an HTTPS incident-management webhook before sharing staging.
# Alerts remain visible in Alertmanager when the local placeholder is used.
ALERTMANAGER_WEBHOOK_URL=http://host.docker.internal:9094/alerts

GRAFANA_ADMIN_USER=admin
