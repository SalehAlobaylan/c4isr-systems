map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

upstream emad_api {
    zone emad_api 64k;
    # Compose can replace the API container and assign it a new address.
    resolver 127.0.0.11 valid=5s ipv6=off;
    server api:8080 resolve;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = /config.js {
        add_header Cache-Control "no-store" always;
        try_files /config.js =404;
    }

    location /api/ {
        proxy_pass http://emad_api;
        proxy_http_version 1.1;
        # Preserve the port during local staging and the original host during
        # production ingress. The API's WebSocket origin check compares Host
        # with Origin, so dropping :8081 would reject browser upgrades.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location = /health {
        proxy_pass http://emad_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
